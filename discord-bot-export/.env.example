# Moon Studio Discord Bot — Environment Template
# Copy this file to .env and fill in the required values before running `npm start`.

# Required: Discord Bot Token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Required: Shared HMAC/Bearer secret configured on the Moon Studio REST API backend
BOT_API_SECRET=your_bot_api_secret_here

# Required: Base URL of the Moon Studio Management REST API (no trailing slash)
API_BASE_URL=https://your-moon-studio-api-host.example.com

# Authorized Administrator Discord User ID (default authorized admin configuration)
DISCORD_ADMIN_IDS=1390253651574132828
